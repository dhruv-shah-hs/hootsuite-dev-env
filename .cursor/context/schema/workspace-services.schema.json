{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hootsuite.invalid/schemas/workspace-services-v1.json",
  "title": "Workspace service catalog",
  "type": "object",
  "required": [
    "services"
  ],
  "properties": {
    "description": {
      "type": "string"
    },
    "always_include": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "path"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        }
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "folder",
          "path",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "folder": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "service",
              "library",
              "idl",
              "frontend"
            ]
          },
          "parent_service": {
            "type": "string"
          },
          "companions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "workspace_presets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "primary",
          "folders"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "primary": {
            "type": "string"
          },
          "folders": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
