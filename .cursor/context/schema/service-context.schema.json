{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hootsuite.invalid/schemas/service-context-v2.json",
  "title": "Service context (multi-service workspace)",
  "description": "Written by resolve-service.py. One entry per runnable folder in hootsuite-dev-env.code-workspace under services, keyed by workspace-services.json id. Primary service fields are mirrored at the root.",
  "type": "object",
  "required": [
    "generated_at",
    "services",
    "primary_service_id"
  ],
  "additionalProperties": true,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional pointer to this schema file for editors."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this file was last written (ISO 8601, UTC)."
    },
    "service_path_resolution": {
      "type": "object",
      "description": "How the product service root was resolved: env, code workspace file, or sibling default.",
      "properties": {
        "source": {
          "type": "string"
        },
        "provenance_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "service_root": {
      "type": [
        "string",
        "null"
      ],
      "description": "Relative path (POSIX, from dev-env root) to the chosen service repo, or null if not detected."
    },
    "makefile": {
      "type": [
        "string",
        "null"
      ],
      "description": "Relative path to the service Makefile, or null if not detected."
    },
    "tech_stack": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "languages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "build_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "manifests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "toolchain": {
      "type": "object",
      "description": "Best-effort runtime/toolchain version pins. Strings as found in manifests, or null when unknown.",
      "additionalProperties": true,
      "properties": {
        "sbt": {
          "type": [
            "string",
            "null"
          ]
        },
        "scala": {
          "type": [
            "string",
            "null"
          ]
        },
        "java": {
          "type": [
            "string",
            "null"
          ]
        },
        "node": {
          "type": [
            "string",
            "null"
          ]
        },
        "python": {
          "type": [
            "string",
            "null"
          ]
        },
        "go": {
          "type": [
            "string",
            "null"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Files consulted (relative to service_root) so the agent can verify pins."
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "service_git": {
      "type": "object",
      "description": "Git state of the service repo (separate clone from the dev-env repo).",
      "additionalProperties": true,
      "properties": {
        "is_git_repo": {
          "type": "boolean"
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "head_sha": {
          "type": [
            "string",
            "null"
          ]
        },
        "head_short_sha": {
          "type": [
            "string",
            "null"
          ]
        },
        "remote_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "default_branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "dirty": {
          "type": "boolean"
        },
        "ahead": {
          "type": "integer",
          "minimum": 0
        },
        "behind": {
          "type": "integer",
          "minimum": 0
        },
        "tracking": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "make_targets": {
      "type": "array",
      "description": "Parsed Makefile targets (skips recipes/directives). Descriptions come from `## ...` comments after the target name.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "primary_commands": {
      "type": "object",
      "description": "Stable role keys (`run`, `test`, `compile_and_test`, `vault_setup_local_dev`, `build_service`, `scalafmt`, `run_minikube`, `help`) \u2192 shell one-liners that cd into service_root and invoke `make <target>`. Only present when the corresponding Make target exists.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "endpoints": {
      "type": "object",
      "description": "Ports and local HTTP examples discovered from Dockerfile EXPOSE lines, README snippets, and application.conf.",
      "additionalProperties": true,
      "properties": {
        "ports": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "http_examples": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "port",
              "path",
              "example"
            ],
            "properties": {
              "port": {
                "type": "integer"
              },
              "path": {
                "type": "string"
              },
              "example": {
                "type": "string"
              }
            }
          }
        },
        "debug": {
          "type": "object",
          "description": "Debug-related ports (e.g. `jdwp`).",
          "additionalProperties": {
            "type": "integer"
          }
        }
      }
    },
    "tests": {
      "type": "object",
      "description": "Test entrypoints and likely source directories.",
      "additionalProperties": true,
      "properties": {
        "runners": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "command",
              "scope"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "command": {
                "type": "string"
              },
              "scope": {
                "type": "string"
              }
            }
          }
        },
        "directories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "config_surface": {
      "type": "object",
      "description": "Configuration layers, darklaunch, `.env` files, and Vault/setup commands the agent should be aware of.",
      "additionalProperties": true,
      "properties": {
        "config_dirs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "config_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "setup_commands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "command",
              "purpose"
