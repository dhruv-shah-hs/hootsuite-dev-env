              "name": {
                "type": "string"
              },
              "command": {
                "type": "string"
              },
              "purpose": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "docs_index": {
      "type": "array",
      "description": "Notable service-repo docs (README, ADRs, CODEOWNERS, Jenkinsfiles, Dockerfile, and files under docs/).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "role"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "excerpt": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "task_repo_fit": {
      "type": "object",
      "description": "Heuristic signal that the current task (from current-task.local.json) actually belongs to this service.",
      "additionalProperties": true,
      "properties": {
        "signal": {
          "type": "string",
          "enum": [
            "strong",
            "weak",
            "none",
            "unknown"
          ]
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "matches": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "keyword",
              "file_count",
              "top_files"
            ],
            "properties": {
              "keyword": {
                "type": "string"
              },
              "file_count": {
                "type": "integer",
                "minimum": 0
              },
              "top_files": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "vscode_launch": {
      "description": "Set when `.vscode/launch.json` was upserted with an attach configuration for the detected stack.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "path": {
              "type": "string",
              "description": "Relative path to the launch.json file."
            },
            "configuration_name": {
              "type": "string"
            },
            "service_name": {
              "type": "string"
            },
            "debug_attach": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "jvm-jdwp",
                    "node-inspector",
                    "debugpy",
                    "delve-remote"
                  ]
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "vscode_type": {
                  "type": "string"
                },
                "hint": {
                  "type": "string"
                }
              }
            }
          }
        }
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Diagnostic messages (missing sibling service-entitlement, missing Makefile targets, no attach template for stack, etc.)."
    },
    "primary_service_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Catalog id of the primary service (cursor.primaryServiceFolder or CURSOR_SERVICE_REPO)."
    },
    "workspace_service_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Ordered runnable ids discovered from the code-workspace file."
    },
